        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string",
              "description": "Filtrer par thème (ex: meditation, leadership, purpose)."
            },
            "search": {
              "type": "string",
              "description": "Recherche textuelle dans le titre."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Nombre max de résultats (défaut 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_teaching",
        "title": "Lire un enseignement",
        "description": "Récupère un enseignement complet par id : contenu, principes, étapes d'application, citations, histoires, concepts visuels.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
